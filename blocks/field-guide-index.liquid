{%- liquid
  assign heading = block.settings.heading
  assign filter_pillar = block.settings.filter_pillar
  assign columns_desktop = block.settings.columns_desktop

  if filter_pillar != 'all'
    assign entries = metaobjects.field_guide_entry.values | where: 'pillar.value', filter_pillar | sort: 'order.value'
  else
    assign entries = metaobjects.field_guide_entry.values | sort: 'order.value'
  endif
-%}

{%- style -%}
  .ht-fg-{{ block.id }} {
    padding-top: {{ block.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ block.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .ht-fg-{{ block.id }} .ht-fg__heading {
    margin: 0 0 1.5rem;
  }

  .ht-fg-{{ block.id }} .ht-fg__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ht-fg-{{ block.id }} .ht-fg__card {
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: {{ settings.card_corner_radius | default: 0 }}px;
    overflow: hidden;
    background: rgb(var(--color-background));
    display: flex;
    flex-direction: column;
  }

  .ht-fg-{{ block.id }} .ht-fg__card a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ht-fg-{{ block.id }} .ht-fg__thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.05);
  }

  .ht-fg-{{ block.id }} .ht-fg__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ht-fg-{{ block.id }} .ht-fg__body {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .ht-fg-{{ block.id }} .ht-fg__pillar {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
    margin: 0 0 0.5rem;
  }

  .ht-fg-{{ block.id }} .ht-fg__title {
    font-weight: 600;
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .ht-fg-{{ block.id }} .ht-fg__dek {
    line-height: 1.5;
    margin: 0 0 0.75rem;
    opacity: 0.85;
  }

  .ht-fg-{{ block.id }} .ht-fg__meta {
    font-size: 0.875rem;
    opacity: 0.6;
    margin: auto 0 0;
  }

  @media screen and (min-width: 750px) {
    .ht-fg-{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
    .ht-fg-{{ block.id }} .ht-fg__list {
      grid-template-columns: repeat({{ columns_desktop }}, 1fr);
      gap: 1.5rem;
    }
  }
{%- endstyle -%}

<div class="ht-fg-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if heading != blank -%}
    <h2 class="ht-fg__heading h1">{{ heading }}</h2>
  {%- endif -%}

  {%- if entries.size > 0 -%}
    <ul class="ht-fg__list">
      {%- for entry in entries -%}
        <li class="ht-fg__card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
          {%- if entry.linked_page.value != blank -%}
            <a href="{{ entry.linked_page.value.url }}">
          {%- endif -%}
            {%- if entry.thumbnail.value != blank -%}
              <div class="ht-fg__thumb">
                {{ entry.thumbnail.value | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 750px) 33vw, 100vw', alt: entry.title.value }}
              </div>
            {%- endif -%}
            <div class="ht-fg__body">
              {%- if entry.pillar.value != blank -%}
                <p class="ht-fg__pillar">{{ entry.pillar.value | replace: '_', ' ' }}</p>
              {%- endif -%}
              <p class="ht-fg__title">{{ entry.title.value }}</p>
              {%- if entry.dek.value != blank -%}
                <p class="ht-fg__dek">{{ entry.dek.value }}</p>
              {%- endif -%}
              {%- if entry.reading_time.value != blank -%}
                <p class="ht-fg__meta">{{ entry.reading_time.value }} min read</p>
              {%- endif -%}
            </div>
          {%- if entry.linked_page.value != blank -%}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p>No field guide entries published yet.</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Field guide index",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Field guide"
    },
    {
      "type": "select",
      "id": "filter_pillar",
      "label": "Filter by pillar",
      "options": [
        { "value": "all", "label": "All entries" },
        { "value": "how_we_think", "label": "How we think" },
        { "value": "how_to_fish", "label": "How to fish" },
        { "value": "what_to_know", "label": "What to know" }
      ],
      "default": "all"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "presets": [
    { "name": "Field guide index" }
  ]
}
{% endschema %}
