{%- liquid
  assign heading = block.settings.heading
  assign dek = block.settings.dek
  assign image = block.settings.image
  assign alignment = block.settings.text_alignment
-%}

{%- style -%}
  .ht-hero-{{ block.id }} {
    padding-top: {{ block.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ block.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    text-align: {{ alignment }};
  }

  .ht-hero-{{ block.id }} .ht-hero__heading {
    margin: 0 0 1rem;
  }

  .ht-hero-{{ block.id }} .ht-hero__dek {
    font-size: 1.25rem;
    line-height: 1.5;
    max-width: 60ch;
    {% if alignment == 'center' %}margin: 0 auto 1.5rem;{% else %}margin: 0 0 1.5rem;{% endif %}
    opacity: 0.85;
  }

  .ht-hero-{{ block.id }} .ht-hero__image {
    margin-top: 1.5rem;
    border-radius: {{ settings.media_radius | default: 0 }}px;
    overflow: hidden;
  }

  .ht-hero-{{ block.id }} .ht-hero__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media screen and (min-width: 750px) {
    .ht-hero-{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="ht-hero-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if heading != blank -%}
    <h1 class="ht-hero__heading h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ heading }}
    </h1>
  {%- endif -%}

  {%- if dek != blank -%}
    <p class="ht-hero__dek{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ dek }}
    </p>
  {%- endif -%}

  {%- if image != blank -%}
    <div class="ht-hero__image{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 750px) 60vw, 100vw', alt: image.alt | default: heading }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page title"
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Dek (subtitle)",
      "info": "Short subtitle that sits under the heading."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional)"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
