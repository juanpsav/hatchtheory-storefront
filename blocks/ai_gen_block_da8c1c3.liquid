{% doc %}
  @prompt
    Add a "Coming Soon" banner and email capture form to the product page. The banner should display a "Coming Soon" message indicating the product is not yet available for purchase. Below it, include an email input field and a submit button so visitors can be notified when the product launches. The form should collect the visitor's email and show a confirmation message after submission. Style it to match the existing theme — clean, modern outdoorsy aesthetic. The section should be insertable on the product page template and sit just below or replacing the add-to-cart button area.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-coming-soon-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-coming-soon-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  .ai-coming-soon-banner-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 20px;
    background-color: {{ block.settings.banner_bg_color }};
    color: {{ block.settings.banner_text_color }};
    border-radius: {{ block.settings.banner_radius }}px;
    font-size: {{ block.settings.banner_font_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
  }

  .ai-coming-soon-banner-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .ai-coming-soon-heading-{{ ai_gen_id }} {
    margin: 0 0 12px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-coming-soon-description-{{ ai_gen_id }} {
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-coming-soon-form-wrapper-{{ ai_gen_id }} {
    max-width: 500px;
    margin: 0 auto;
  }

  .ai-coming-soon-form-field-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
  }

  .ai-coming-soon-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 14px 16px;
    border: {{ block.settings.input_border_thickness }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_radius }}px;
    font-size: 15px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.input_text_color }};
  }

  .ai-coming-soon-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
    opacity: 0.7;
  }

  .ai-coming-soon-input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.button_bg_color }};
    outline-offset: 2px;
  }

  .ai-coming-soon-button-{{ ai_gen_id }} {
    padding: 14px 28px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .ai-coming-soon-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-coming-soon-message-{{ ai_gen_id }} {
    padding: 12px 16px;
    border-radius: {{ block.settings.input_radius }}px;
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-coming-soon-success-{{ ai_gen_id }} {
    background-color: {{ block.settings.success_bg_color }};
    color: {{ block.settings.success_text_color }};
  }

  .ai-coming-soon-error-{{ ai_gen_id }} {
    background-color: {{ block.settings.error_bg_color }};
    color: {{ block.settings.error_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-coming-soon-form-field-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-coming-soon-button-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-coming-soon-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }

    .ai-coming-soon-banner-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.banner_font_size }}px * 0.9);
    }
  }
{% endstyle %}

<coming-soon-form-{{ ai_gen_id }}
  class="ai-coming-soon-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-coming-soon-container-{{ ai_gen_id }}">
    <div class="ai-coming-soon-banner-{{ ai_gen_id }}">
      <svg
        class="ai-coming-soon-banner-icon-{{ ai_gen_id }}"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      {{ block.settings.banner_text }}
    </div>

    {% if block.settings.heading != blank %}
      <h2 class="ai-coming-soon-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-coming-soon-description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    <div class="ai-coming-soon-form-wrapper-{{ ai_gen_id }}">
      {%- form 'contact' -%}
        <input
          type="hidden"
          name="contact[coming_soon_product_id]"
          value="{{ product.id }}"
        >
        <input
          type="hidden"
          name="contact[coming_soon_product_title]"
          value="{{ product.title }}"
        >

        <div class="ai-coming-soon-form-field-{{ ai_gen_id }}">
          <input
            type="email"
            name="contact[email]"
            class="ai-coming-soon-input-{{ ai_gen_id }}"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-coming-soon-error-{{ ai_gen_id }}"
            {% endif %}
            {% if form.posted_successfully? %}
              aria-describedby="ai-coming-soon-success-{{ ai_gen_id }}"
            {% endif %}
            placeholder="{{ block.settings.email_placeholder }}"
            required
          >
          <button
            type="submit"
            class="ai-coming-soon-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <div
            id="ai-coming-soon-success-{{ ai_gen_id }}"
            class="ai-coming-soon-message-{{ ai_gen_id }} ai-coming-soon-success-{{ ai_gen_id }}"
          >
            {{ block.settings.success_message }}
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div
            id="ai-coming-soon-error-{{ ai_gen_id }}"
            class="ai-coming-soon-message-{{ ai_gen_id }} ai-coming-soon-error-{{ ai_gen_id }}"
          >
            {{ form.errors.messages.email }}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</coming-soon-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ComingSoonForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        if (form && form.classList.contains('contact-form')) {
          form.addEventListener('submit', () => {
            const button = this.querySelector('.ai-coming-soon-button-{{ ai_gen_id }}');
            if (button) {
              button.disabled = true;
              button.textContent = '{{ block.settings.button_submitting_text }}';
            }
          });
        }
      }
    }

    customElements.define('coming-soon-form-{{ ai_gen_id }}', ComingSoonForm{{ ai_gen_id }});
  })();
</script>

