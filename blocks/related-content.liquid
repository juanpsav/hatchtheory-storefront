{%- liquid
  assign heading = block.settings.heading
  assign entry_1 = block.settings.entry_1
  assign entry_2 = block.settings.entry_2
  assign entry_3 = block.settings.entry_3

  assign has_entries = false
  if entry_1 != blank or entry_2 != blank or entry_3 != blank
    assign has_entries = true
  endif
-%}

{%- style -%}
  .ht-related-{{ block.id }} {
    padding-top: {{ block.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ block.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
    margin-top: 2rem;
  }

  .ht-related-{{ block.id }} .ht-related__heading {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1rem;
  }

  .ht-related-{{ block.id }} .ht-related__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ht-related-{{ block.id }} .ht-related__card a,
  .ht-related-{{ block.id }} .ht-related__card-inner {
    display: block;
    padding: 1rem;
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: {{ settings.card_corner_radius | default: 0 }}px;
    text-decoration: none;
    color: inherit;
    background: rgb(var(--color-background));
    height: 100%;
  }

  .ht-related-{{ block.id }} .ht-related__pillar {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
    margin: 0 0 0.25rem;
  }

  .ht-related-{{ block.id }} .ht-related__title {
    font-weight: 600;
    margin: 0 0 0.25rem;
  }

  .ht-related-{{ block.id }} .ht-related__dek {
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
  }

  @media screen and (min-width: 750px) {
    .ht-related-{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
    .ht-related-{{ block.id }} .ht-related__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }
{%- endstyle -%}

{%- if has_entries -%}
  <aside class="ht-related-{{ block.id }}" {{ block.shopify_attributes }}>
    {%- if heading != blank -%}
      <h2 class="ht-related__heading">{{ heading }}</h2>
    {%- endif -%}
    <ul class="ht-related__list">
      {%- if entry_1 != blank -%}
        {%- render 'ht-related-card', entry: entry_1 -%}
      {%- endif -%}
      {%- if entry_2 != blank -%}
        {%- render 'ht-related-card', entry: entry_2 -%}
      {%- endif -%}
      {%- if entry_3 != blank -%}
        {%- render 'ht-related-card', entry: entry_3 -%}
      {%- endif -%}
    </ul>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Related content",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Keep reading"
    },
    {
      "type": "metaobject",
      "id": "entry_1",
      "label": "Entry 1",
      "metaobject_type": "field_guide_entry"
    },
    {
      "type": "metaobject",
      "id": "entry_2",
      "label": "Entry 2",
      "metaobject_type": "field_guide_entry"
    },
    {
      "type": "metaobject",
      "id": "entry_3",
      "label": "Entry 3",
      "metaobject_type": "field_guide_entry"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    }
  ],
  "presets": [
    { "name": "Related content" }
  ]
}
{% endschema %}
