{% comment %}
  "Why this box exists" with the drawer of one hundred patterns (Hatch Theory, 2026-10-27).
  The grid uses the dark icons of the product's Fly Box Content metaobjects. The first entries
  (as many as "Flies that stay") stay lit; the rest fade when the section scrolls into view.
  Surprise flies are never pictured.
{% endcomment %}
{{ 'ht-fly-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ht-fly-drawer.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign src = section.settings.product | default: product
  assign flies = src.metafields.custom.fly_box_content.value
  assign icons = ''
  for fly in flies
    if fly.is_surprise.value != true and fly.icon.value != blank
      assign icon_url = fly.icon.value | image_url: width: 160
      assign icons = icons | append: icon_url | append: '|'
    endif
  endfor
  assign icon_list = icons | split: '|'
  assign keep = section.settings.keep_count
  if keep > icon_list.size
    assign keep = icon_list.size
  endif
  assign total = section.settings.total
-%}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
<section class="ht-drawer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width ht-drawer__inner">
    <div class="ht-drawer__text{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.heading != blank -%}<h2 class="ht-drawer__heading ht-display">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.caption != blank -%}<p class="ht-drawer__caption caption-with-letter-spacing">{{ section.settings.caption | escape }}</p>{%- endif -%}
      {%- if section.settings.lede != blank -%}<div class="ht-drawer__lede rte">{{ section.settings.lede }}</div>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="ht-drawer__body rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    {%- if icon_list.size > 0 and total > 0 -%}
      {%- comment -%} Keepers spread through the grid at fixed, even-ish positions {%- endcomment -%}
      {%- assign step = total | divided_by: keep | default: total -%}
      <ht-fly-drawer class="ht-drawer__grid" aria-hidden="true" style="--cols: {{ section.settings.columns }};">
        {%- for i in (1..total) -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign slot = idx | modulo: step -%}
          {%- assign k = idx | divided_by: step -%}
          {%- assign keeper_slot = k | times: 7 | plus: 3 | modulo: step -%}
          {%- if slot == keeper_slot and k < keep -%}
            <span class="ht-drawer__cell is-keep"><img src="{{ icon_list[k] }}" alt="" loading="lazy" width="160" height="160"></span>
          {%- else -%}
            {%- assign pick = idx | modulo: icon_list.size -%}
            {%- assign rot = idx | times: 37 | modulo: 70 | minus: 35 -%}
            {%- assign delay = idx | times: 53 | modulo: 90 -%}
            <span class="ht-drawer__cell" style="--r: {{ rot }}deg; --d: {{ delay }}0ms;"><img src="{{ icon_list[pick] }}" alt="" loading="lazy" width="160" height="160"></span>
          {%- endif -%}
        {%- endfor -%}
      </ht-fly-drawer>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Why this box exists",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why this box exists" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "You don't need a hundred flies. You just need the right ones." },
    { "type": "richtext", "id": "lede", "label": "Lead paragraph" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Drawer" },
    { "type": "product", "id": "product", "label": "Product", "info": "Icons come from this product's Fly Box Content metaobjects (Icon (dark ink))." },
    { "type": "range", "id": "total", "label": "Patterns in the drawer", "min": 20, "max": 100, "step": 10, "default": 100 },
    { "type": "range", "id": "keep_count", "label": "Flies that stay", "min": 1, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 5, "max": 12, "step": 1, "default": 10 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 120 }
  ],
  "presets": [{ "name": "Why this box exists" }]
}
{% endschema %}
