{{ 'ht-field-guide.css' | asset_url | stylesheet_tag }}
{%- render 'ht-fg-standfirst-font' -%}
<script src="{{ 'ht-field-guide.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign all_entries = shop.metaobjects.field_guide_entry.values | sort: 'order'
  assign pillar_order = section.settings.pillar_order | split: ','
-%}

<div class="page-width ht-fg ht-fg-index--{{ section.settings.layout }}{% if section.settings.title_weight == 'light' %} ht-fg--title-light{% endif %} section-{{ section.id }}-padding">
  <header class="ht-fg-hero">
    <h1 class="ht-fg-hero__title">{{ section.settings.title | default: page.title | escape }}</h1>
    <div class="ht-fg-hero__text">
      {%- if section.settings.intro != blank -%}
        <div class="ht-fg-hero__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
      {%- if section.settings.layout == 'cards' -%}
      <nav class="ht-fg-hero__nav" aria-label="{{ section.settings.title | escape }}">
        <ul>
          {%- for pillar_name in pillar_order -%}
            {%- assign pillar_clean = pillar_name | strip -%}
            {%- assign pillar_entries = all_entries | where: 'pillar', pillar_clean -%}
            {%- if pillar_entries.size > 0 -%}
              <li><a href="#{{ pillar_clean | handleize }}">{{ pillar_clean | capitalize }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
      {%- endif -%}
    </div>
    <div class="ht-fg-hero__plate">
      {%- if section.settings.layout == 'cards' -%}{%- assign hero_sizes = '(min-width: 1200px) 1100px, 100vw' -%}{%- else -%}{%- assign hero_sizes = '(min-width: 990px) 40vw, 100vw' -%}{%- endif -%}
      {%- render 'ht-fg-plate', key: 'hero', eager: true, caption: true, sizes: hero_sizes -%}
    </div>
  </header>

  <div class="ht-fg-pillars">
  {%- for pillar_name in pillar_order -%}
    {%- assign pillar_clean = pillar_name | strip -%}
    {%- assign pillar_entries = all_entries | where: 'pillar', pillar_clean -%}
    {%- if pillar_entries.size > 0 -%}
      {%- assign column_count = pillar_entries.size | at_most: 3 -%}
      <section class="ht-fg-pillar" id="{{ pillar_clean | handleize }}" aria-labelledby="Pillar-{{ section.id }}-{{ forloop.index }}">
        <h2 class="ht-fg-pillar__title" id="Pillar-{{ section.id }}-{{ forloop.index }}">{{ pillar_clean | capitalize }}</h2>
        <ul class="ht-fg-pillar__list" style="--ht-fg-columns: {{ column_count }};" role="list">
          {%- for entry in pillar_entries -%}
            {%- if entry.linked_page.value != blank -%}
              <li>{%- if section.settings.layout == 'compact' -%}{%- assign use_thumb = true -%}{%- else -%}{%- assign use_thumb = false -%}{%- endif -%}{%- render 'ht-fg-entry', entry: entry, view: section.settings.article_view, thumb: use_thumb -%}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}
  {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Field Guide plates",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Page title", "default": "Field Guide" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Short pieces on how to fish smarter with less gear. Read straight through, or pull one up on the bank.</p>"
    },
    {
      "type": "text",
      "id": "pillar_order",
      "label": "Pillar order (comma-separated)",
      "info": "Must match the metaobject pillar values exactly.",
      "default": "less is more, what to cast, how to use the box"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "compact",
      "options": [
        { "value": "compact", "label": "Index: groups side by side, compact rows" },
        { "value": "cards", "label": "Cards: large plates" }
      ]
    },
    {
      "type": "text",
      "id": "article_view",
      "label": "Article template preview",
      "info": "Optional. Adds ?view=<value> to article links so a test article template can be previewed before pages are assigned to it. Leave empty in production."
    },
    { "type": "header", "content": "Section padding" },
    { "type": "select", "id": "title_weight", "label": "Title weight", "default": "light", "options": [{ "value": "light", "label": "Light" }, { "value": "regular", "label": "Regular" }] },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [{ "name": "Field Guide plates" }]
}
{% endschema %}
