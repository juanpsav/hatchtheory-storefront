{%- style -%}
  .field-guide-teaser {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .field-guide-teaser {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .field-guide-teaser__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.15);
  }

  .field-guide-teaser__heading {
    margin: 0;
    font-size: 2.4rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .field-guide-teaser__link {
    font-size: 1.3rem;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.2rem;
    transition: opacity 0.2s ease;
  }

  .field-guide-teaser__link:hover {
    opacity: 0.7;
  }

  .field-guide-teaser__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media screen and (min-width: 750px) {
    .field-guide-teaser__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 4rem;
    }
  }

  .field-guide-teaser__card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .field-guide-teaser__card:hover {
    opacity: 0.75;
  }

  .field-guide-teaser__pillar {
    display: block;
    font-size: 1rem;
    letter-spacing: 0.15rem;
    text-transform: uppercase;
    opacity: 0.5;
    margin-bottom: 1rem;
  }

  .field-guide-teaser__title {
    font-size: 1.9rem;
    line-height: 1.3;
    margin: 0 0 1rem;
    font-weight: 500;
  }

  .field-guide-teaser__dek {
    font-size: 1.4rem;
    line-height: 1.55;
    margin: 0;
    opacity: 0.8;
  }
{%- endstyle -%}

<div class="page-width field-guide-teaser">
  <header class="field-guide-teaser__header">
    <h2 class="field-guide-teaser__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.see_all_label != blank -%}
      <a href="{{ section.settings.see_all_url | default: '/pages/field-guide' }}" class="field-guide-teaser__link">
        {{ section.settings.see_all_label | escape }}
      </a>
    {%- endif -%}
  </header>

  {%- liquid
    assign all_entries = shop.metaobjects.field_guide_entry.values | sort: 'order'
    assign featured_handles = section.settings.featured_handles | split: ','
    assign featured = ''
  -%}

  <ul class="field-guide-teaser__list">
    {%- for handle_raw in featured_handles -%}
      {%- assign target_handle = handle_raw | strip -%}
      {%- for entry in all_entries -%}
        {%- if entry.system.handle == target_handle -%}
          {%- assign target = entry.linked_page.value -%}
          {%- if target != blank -%}
            <li>
              <a href="{{ target.url }}" class="field-guide-teaser__card">
                {%- if entry.pillar.value != blank -%}
                  <span class="field-guide-teaser__pillar">{{ entry.pillar.value }}</span>
                {%- endif -%}
                <h3 class="field-guide-teaser__title">{{ entry.title.value }}</h3>
                {%- if entry.dek.value != blank -%}
                  <p class="field-guide-teaser__dek">{{ entry.dek.value }}</p>
                {%- endif -%}
              </a>
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Field Guide teaser",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Field Guide"
    },
    {
      "type": "text",
      "id": "see_all_label",
      "label": "See-all link label",
      "default": "All field notes"
    },
    {
      "type": "url",
      "id": "see_all_url",
      "label": "See-all link URL",
      "info": "Defaults to /pages/field-guide"
    },
    {
      "type": "text",
      "id": "featured_handles",
      "label": "Featured entry handles",
      "info": "Comma-separated metaobject handles, in display order. Use 3 for a balanced row.",
      "default": "why-six-flies-not-sixty, the-hatch-calendar, dry-nymph-or-streamer"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Field Guide teaser"
    }
  ]
}
{% endschema %}
