    "custom_liquid_AEjBkn": {
      "type": "custom-liquid",
      "name": "Patterns - custom Liquid",
      "settings": {
        "custom_liquid": "<style>\n  .hatch-table-container {\n    background-color: #1E2E27; /* Deep Pine Green */\n    color: #ECF3EF; /* Soft Sage */\n    padding: 40px 20px;\n    font-family: 'Platypi', serif; /* Uses your theme font if loaded, else serif */\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n  .hatch-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 40px;\n  }\n  @media (min-width: 768px) {\n    .hatch-grid {\n      grid-template-columns: 1fr 1fr 1fr;\n      gap: 20px;\n    }\n  }\n  .hatch-column {\n    border-top: 1px solid #4A5D54; /* Subtle divider */\n    padding-top: 20px;\n  }\n  .hatch-header {\n    font-size: 1.2rem;\n    font-weight: 600;\n    margin-bottom: 25px;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    color: rgba(236, 243, 239, 0.65);\n  }\n  .fly-item {\n    margin-bottom: 30px;\n  }\n  .fly-name {\n    font-family: 'Platypi', serif;\n    font-size: 1.1rem;\n    font-weight: 500;\n    margin-bottom: 4px;\n    color: #FFFFFF;\n  }\n  .fly-details {\n    font-family: sans-serif;\n    font-size: 0.9rem;\n    opacity: 0.6;\n    margin-bottom: 8px;\n    font-style: italic;\n  }\n  .fly-desc {\n    font-family: sans-serif;\n    font-size: 0.95rem;\n    line-height: 1.5;\n    opacity: 0.6;\n  }\n\n  .fly-item {\n    display: grid;\n    grid-template-columns: 48px 1fr;\n    column-gap: 16px;\n  }\n  .fly-icon {\n    grid-column: 1;\n    grid-row: 1 / span 3;\n  }\n  .fly-icon img {\n    width: 100%;\n    height: auto;\n    display: block;\n    opacity: 0.95;\n  }\n  .fly-icon--wildcard {\n    font-family: 'Platypi', serif;\n    font-size: 1.7rem;\n    color: #ECF3EF;\n    opacity: 0.85;\n    line-height: 1.2;\n    text-align: center;\n  }\n  .fly-name, .fly-details, .fly-desc {\n    grid-column: 2;\n  }\n</style>\n\n<div class=\"hatch-table-container\">\n  <div class=\"hatch-grid\">\n    <div class=\"hatch-column\">\n      <div class=\"hatch-header\">Surface (Dries)</div>\n      \n      <div class=\"fly-item\">\n        <div class=\"fly-icon\"><img src=\"{{ 'parachute-adams-cream.png' | file_img_url: '120x' }}\" alt=\"\" width=\"48\" height=\"48\" loading=\"lazy\"></div>\n        <div class=\"fly-name\">Parachute Adams (x5)</div>\n        <div class=\"fly-details\">Sizes 14</div>\n        <div class=\"fly-desc\">The universal mayfly when fish are feeding on the surface.</div>\n      </div>\n      \n      <div class=\"fly-item\">\n        <div class=\"fly-icon\"><img src=\"{{ 'elk-hair-caddis-cream.png' | file_img_url: '120x' }}\" alt=\"\" width=\"48\" height=\"48\" loading=\"lazy\"></div>\n        <div class=\"fly-name\">Elk Hair Caddis (x5)</div>\n        <div class=\"fly-details\">Sizes 12</div>\n        <div class=\"fly-desc\">Floats high and stays visible. Great for rough waters.</div>\n      </div>\n    </div>\n\n    <div class=\"hatch-column\">\n      <div class=\"hatch-header\">Sub-Surface (Nymphs)</div>\n      \n      <div class=\"fly-item\">\n        <div class=\"fly-icon\"><img src=\"{{ 'beaded-pheasant-tail-nymph-cream.png' | file_img_url: '120x' }}\" alt=\"\" width=\"48\" height=\"48\" loading=\"lazy\"></div>\n        <div class=\"fly-name\">Pheasant Tail (x5)</div>\n        <div class=\"fly-details\">Sizes 16</div>\n        <div class=\"fly-desc\">The \"every-bug.\" Imitates almost any swimming nymph in the water column.</div>\n      </div>\n      \n      <div class=\"fly-item\">\n        <div class=\"fly-icon\"><img src=\"{{ 'beaded-hares-ear-cream.png' | file_img_url: '120x' }}\" alt=\"\" width=\"48\" height=\"48\" loading=\"lazy\"></div>\n        <div class=\"fly-name\">Hare’s Ear (x5)</div>\n        <div class=\"fly-details\">Sizes 14</div>\n        <div class=\"fly-desc\">Buggy, messy profile suggesting many insects.</div>\n      </div>\n    </div>\n\n    <div class=\"hatch-column\">\n      <div class=\"hatch-header\">Streamers & Utility</div>\n      \n      <div class=\"fly-item\">\n        <div class=\"fly-icon\"><img src=\"{{ 'woolly-bugger-cream.png' | file_img_url: '120x' }}\" alt=\"\" width=\"48\" height=\"48\" loading=\"lazy\"></div>\n        <div class=\"fly-name\">Woolly Bugger (x3)</div>\n        <div class=\"fly-details\">Size 8 (Olive)</div>\n        <div class=\"fly-desc\">For searching deep pools. Looks like a leech, minnow, or crayfish.</div>\n      </div>\n      \n      <div class=\"fly-item\">\n        <div class=\"fly-icon fly-icon--wildcard\">?</div>\n        <div class=\"fly-name\">WILDCARD FLIES (x3)</div>\n        <div class=\"fly-details\">Varied sizes</div>\n        <div class=\"fly-desc\">The fun but useful complements to your fly box. Varied additional flies with their description and instructions.</div>\n      </div>\n    </div>\n  </div>\n</div>",
        "color_scheme": "scheme-3",
        "padding_top": 0,
        "padding_bottom": 52
      }
    },
